{
  "name": "factory-operations-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:business": "playwright test --config playwright.business.config.ts",
    "test:identity": "playwright test --config playwright.identity.config.ts",
    "test:portal": "playwright test --config playwright.portal.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
