new file mode 100644
index 0000000..2ac6774
--- /dev/null
+++ b/scripts/export-operations-registry.cjs
@@ -0,0 +1,17 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const { FACTORY_REGISTRY, DEVICE_REGISTRY, ROOM_REGISTRY, FAN_REGISTRY } = require('../server/monitoring/registry');
+const source = path.join(__dirname, '../server/monitoring/registry.js');
+const registry = {
+  source: 'server/monitoring/registry.js',
+  sha256: crypto.createHash('sha256').update(fs.readFileSync(source)).digest('hex'),
+  factories: FACTORY_REGISTRY.map(factory => ({ id: factory.factory_id, gateways: factory.device_ids })),
+  devices: DEVICE_REGISTRY.map(device => ({
+    id: device.device_id, factory: device.factory_id,
+    targets: [device.device_id,
+      ...ROOM_REGISTRY.filter(room => room.device_id === device.device_id).map(room => room.room_id),
+      ...FAN_REGISTRY.filter(fan => fan.device_id === device.device_id).map(fan => fan.fan_id)],
+  })),
+};
+fs.writeFileSync(path.join(__dirname, '../frontend/src/operations-registry.json'), JSON.stringify(registry, null, 2) + '\n');
diff --git a/tests/operations-monitor.test.mjs b/tests/operations-monitor.test.mjs
new file mode 100644
index 0000000..0d49ec5
--- /dev/null
+++ b/tests/operations-monitor.test.mjs
@@ -0,0 +1,30 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { createRequire } from 'node:module'
+import { operationsRouteForGateways, linkedGateway, validMonitoringLink } from '../frontend/src/operations-monitor.js'
+const require = createRequire(import.meta.url)
+const { DEVICE_REGISTRY, ROOM_REGISTRY, FAN_REGISTRY } = require('../server/monitoring/registry')
+const registry = JSON.parse(readFileSync(new URL('../frontend/src/operations-registry.json', import.meta.url)))
+test('browser registry contains exact reviewed monitor IDs, not display-name matches', () => {
+  assert.equal(registry.sha256, createHash('sha256').update(readFileSync(new URL('../server/monitoring/registry.js', import.meta.url))).digest('hex'))
+  assert.deepEqual(registry.devices.map(d => d.id), DEVICE_REGISTRY.map(d => d.device_id))
+  for (const device of registry.devices) {
+    assert.deepEqual(device.targets, [device.id,...ROOM_REGISTRY.filter(r => r.device_id === device.id).map(r => r.room_id),...FAN_REGISTRY.filter(f => f.device_id === device.id).map(f => f.fan_id)])
+  }
+})
+test('unregistered and grouped gateways never choose an arbitrary factory', () => {
+  for (const ids of [[],[45482,45865],['新哨加工厂二厂'],['045482']]) assert.deepEqual(operationsRouteForGateways(ids), { path: '/operations/from-monitor' })
+  assert.equal(operationsRouteForGateways([45482, '45482']).query.monitor_factory_id, 'FAC_XINSHAO_2')
+})
+test('return links require exact factory, gateway and equipment identities', () => {
+  const link = { monitor_factory_id:'FAC_XINSHAO_2',monitor_gateway_id:'45482',monitor_device_id:'45482' }
+  const devices = [{id:45865,name:'same name'}, {id:45482,name:'same name'}]
+  assert.equal(linkedGateway(link,devices),devices[1])
+  for (const changed of [{monitor_factory_id:'FAC_MOUDING'}, {monitor_gateway_id:'45865'}, {monitor_device_id:'unknown'}]) {
+    assert.equal(validMonitoringLink({...link,...changed}),false)
+    assert.equal(linkedGateway({...link,...changed},devices),null)
+  }
+  assert.equal(linkedGateway(link,[]),null)
+})
