diff --git a/frontend/src/operations-monitor.js b/frontend/src/operations-monitor.js
new file mode 100644
index 0000000..0ccc4c7
--- /dev/null
+++ b/frontend/src/operations-monitor.js
@@ -0,0 +1,20 @@
+import registry from './operations-registry.json' with { type: 'json' }
+
+export function operationsRouteForGateways(ids) {
+  const gateways = [...new Set((ids || []).map(String))]
+  if (gateways.length !== 1) return { path: '/operations/from-monitor' }
+  const device = registry.devices.find(item => item.id === gateways[0])
+  return device ? { path: '/operations/from-monitor', query: { monitor_factory_id: device.factory, monitor_device_id: device.id } }
+    : { path: '/operations/from-monitor' }
+}
+
+export function validMonitoringLink(link) {
+  if (!link) return false
+  return registry.devices.some(device => device.id === link.monitor_gateway_id
+    && device.factory === link.monitor_factory_id && device.targets.includes(link.monitor_device_id))
+}
+
+export function linkedGateway(link, devices) {
+  if (!validMonitoringLink(link)) return null
+  return devices.find(device => String(device.id) === link.monitor_gateway_id) || null
+}
