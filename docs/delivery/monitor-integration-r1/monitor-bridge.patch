--- /dev/null
+++ b/frontend/src/components/OperationsMonitorLink.vue
@@ -0,0 +1,27 @@
+<script setup>
+import { computed, onUnmounted, ref, watch } from 'vue'
+import { useRoute } from 'vue-router'
+import { useDataStore } from '../stores/data'
+import { readLink } from '../../vendor/factory-operations-portal/src/integrations/monitor/links'
+import { linkedGateway, validMonitoringLink } from '../operations-monitor'
+const emit = defineEmits(['open'])
+const route = useRoute(), data = useDataStore(), link = ref(null), message = ref('正在校验监控关联…')
+const device = computed(() => linkedGateway(link.value, data.devices))
+let controller
+watch(() => route.fullPath, async () => {
+  controller?.abort()
+  const current = new AbortController(); controller = current
+  link.value = null; message.value = '正在校验监控关联…'
+  try {
+    const factory = route.query.ops_factory, asset = route.query.ops_asset
+    if (typeof factory !== 'string' || typeof asset !== 'string') { message.value = '尚未关联'; return }
+    const result = await readLink('asset-link', { factory_id: factory, asset_id: asset }, current.signal)
+    if (current.signal.aborted) return
+    if (!validMonitoringLink(result)) { message.value = '尚未关联'; return }
+    link.value = result; message.value = `已关联 ${result.monitor_device_id}`
+  } catch { if (!current.signal.aborted) message.value = '关联查询失败或无访问权限' }
+}, { immediate: true })
+onUnmounted(() => controller?.abort())
+</script>
+<template><div class="operations-return" role="status"><span>{{ message }}</span><template v-if="device"><span>{{ device.online ? '网关在线' : '网关离线' }}</span><button @click="emit('open', device)">查看设备状态</button></template><span v-else-if="link">监控数据未就绪</span></div></template>
+<style scoped>.operations-return{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:12px 0;margin-bottom:16px;border-block:1px solid #526550;color:#b8cc9e;font-size:13px}.operations-return button{border:1px solid #526550;background:#27352c;color:inherit;border-radius:4px;padding:7px 12px;min-height:38px;cursor:pointer}</style>
