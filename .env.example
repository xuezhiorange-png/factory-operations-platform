# Development-only example. NEVER copy these passwords to production.
POSTGRES_DB=factory_ops_dev
POSTGRES_USER=factory_ops_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
POSTGRES_PORT=55432
# For local development only; inject a real secret outside Git.
DATABASE_URL=postgresql+psycopg://factory_ops_dev:CHANGE_ME_LOCAL_DEV_ONLY@127.0.0.1:55432/factory_ops_dev
# VITE_ASSETS_API_ENABLED=true enables only asset read UI; it never grants authorization.
# Identity requires an exact HTTPS origin and all Feishu credentials injected outside Git.
# FACTORY_OPS_PUBLIC_ORIGIN=https://your-review-host.example
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TENANT_KEY=
# VITE_IDENTITY_ENABLED=true (frontend capability only; never grants a role)
# Remote MCP is independent of Feishu OAuth and disabled unless explicitly enabled.
# FACTORY_OPS_MCP_ENABLED=1
# FACTORY_OPS_MCP_PUBLIC_ORIGIN=https://your-isolated-review-host.example
# AILY_TENANT_ID=<official-numeric-tenant-id>
# AILY_ALLOWED_AGENT_IDS=<approved-agent-id>
# AILY_IDENTITY_JWT_SECRET=<inject-platform-generated-raw-secret-outside-Git>
# FACTORY_OPS_ALLOW_OFFLINE_BOOTSTRAP=1 (operator command only; never in web runtime)
